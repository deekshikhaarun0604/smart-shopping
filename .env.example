# ================================================================
# SmartShop – Knowledge Graph Recommendation System (.env.example)
# ================================================================

# Port provided dynamically by Render in production, or 5000 for local testing
PORT=5000

# Node Environment: production (on Render) or development (local)
NODE_ENV=production

# MongoDB Connection String:
# ----------------------------------------------------------------
# Option A - Local MongoDB (default for local development):
# MONGODB_URI=mongodb://127.0.0.1:27017/smartshop
#
# Option B - MongoDB Atlas Cloud (REQUIRED for Render deployment):
# Replace <username>, <password>, and <cluster-url> with your Atlas cluster details:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/smartshop?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/smartshop
